{
  "rules": [
    {
      "enabled": true,
      "name": "nod-abandoned-staging",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": ["nod-documents/staging/"]
        },
        "actions": {
          "baseBlob": {
            "delete": { "daysAfterModificationGreaterThan": 3 }
          }
        }
      }
    }
  ]
}
